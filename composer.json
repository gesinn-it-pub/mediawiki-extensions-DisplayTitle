{
	"name": "mediawiki/display-title",
	"type": "mediawiki-extension",
	"description": "Uses displaytitle page property in link text, subtitle, and talk page title; provides parser function to query displaytitle",
	"keywords": [
		"wiki",
		"MediaWiki",
		"extension"
	],
	"homepage": "https://www.mediawiki.org/wiki/Extension:DisplayTitle",
	"license": "MIT",
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "45.0.0",
		"mediawiki/mediawiki-phan-config": "0.14.0",
		"mediawiki/minus-x": "1.1.3",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0"
	},
	"scripts": {
		"test": [
			"@analyze",
			"@phpunit"
		],
		"test-coverage": [
			"@analyze",
			"@phpunit-coverage"
		],
		"analyze": [
			"@lint",
			"@phpcs",
			"@minus-x",
			"@phan"
		],
		"phpunit": "php ../../tests/phpunit/phpunit.php -c phpunit.xml.dist",
		"phpunit-coverage": "php ../../tests/phpunit/phpunit.php -c phpunit.xml.dist --coverage-text --coverage-html coverage/php --coverage-clover coverage/php/coverage.xml",
		"lint": "parallel-lint . --exclude vendor --exclude node_modules",
		"fix": [
			"minus-x fix .",
			"phpcbf"
		],
		"minus-x": "minus-x check .",
		"phpcs": "phpcs -sp --cache",
		"phan": "phan --allow-polyfill-parser"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
